# Copy to .env and fill in. .env is gitignored.

# --- LLM provider (only needed for the discovery run; replay never calls an LLM) ---
# Supported: gemini
# Gemini has a free tier via Google AI Studio: https://aistudio.google.com/apikey
CUA_LLM_PROVIDER=gemini
GEMINI_API_KEY=
CUA_LLM_MODEL=gemini-2.5-flash

# --- Target app (the local mock legacy console) ---
CUA_TARGET_BASE_URL=http://127.0.0.1:8800

# --- Operator / escalation broker ---
CUA_OPERATOR_BASE_URL=http://127.0.0.1:8850
