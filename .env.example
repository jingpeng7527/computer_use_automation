# Copy to .env and fill in. .env is gitignored.

# --- LLM provider (only needed for the discovery run; replay never calls an LLM) ---
# Gemini is primary. Free tier via Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
CUA_LLM_MODEL=gemini-3.6-flash

# Groq is the secondary fallback -- used only if the Gemini call itself fails
# (network error, rate limit, etc). Optional: if unset, discovery just runs
# on Gemini alone with no fallback. Free tier: https://console.groq.com/keys
GROQ_API_KEY=
CUA_GROQ_MODEL=llama-3.3-70b-versatile

# --- Target app (the local mock legacy console) ---
CUA_TARGET_BASE_URL=http://127.0.0.1:8800
