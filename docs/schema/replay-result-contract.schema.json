    "redactions": {
      "items": {
        "type": "string"
      },
      "title": "Redactions",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "business_outcome",
        "failed",
        "escalated"
