          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Money"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
