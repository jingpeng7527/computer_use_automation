        "detected_after_step": {
          "title": "Detected After Step",
          "type": "string"
        },
        "outputs": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Money"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Outputs",
          "type": "object"
        }
      },
      "required": [
        "code",
        "description",
        "detected_after_step"
