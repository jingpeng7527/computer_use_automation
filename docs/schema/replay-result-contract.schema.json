        "step_id",
        "step_intent",
        "kind",
        "expected",
        "observed"
      ],
      "title": "FailureDetail",
      "type": "object"
    },
    "Money": {
      "description": "The only representation for currency anywhere in this system. Never a\nfloat: binary floating point cannot represent decimal currency exactly,\nand this is regulated financial data (REPORT.md sec 2).",
      "properties": {
        "amount_minor": {
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "StepResult": {
