digraph schema {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.45", ranksep="1.0", fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica"];
  edge [color="#425466", fontname="Helvetica", fontsize=9, arrowsize=0.7];
  labelloc="t"; label="Replay result contract"; fontsize=20; fontname="Helvetica";
  subgraph cluster_0 {
    label="Terminal payloads"; color="#b9c6d8"; penwidth=1; style="rounded";
    "BusinessOutcomeResult" [label=<<TABLE BGCOLOR="#ffffff" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8eef7"><B>BusinessOutcomeResult</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">code: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">description: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">detected_after_step: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">outputs?: Money</FONT></TD></TR></TABLE>>];
    "EscalationRef" [label=<<TABLE BGCOLOR="#ffffff" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8eef7"><B>EscalationRef</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">intervention_id: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">reason: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">raised_at_step: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">session_handle: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resolved?: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">operator_actions?: list[scalar]</FONT></TD></TR></TABLE>>];
    "FailureDetail" [label=<<TABLE BGCOLOR="#ffffff" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8eef7"><B>FailureDetail</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">step_id: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">step_intent: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kind: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">expected: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">observed: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">screenshot_ref?: scalar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">retryable?: boolean</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_1 {
    label="Trace and typed values"; color="#b9c6d8"; penwidth=1; style="rounded";
    "Money" [label=<<TABLE BGCOLOR="#ffffff" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8eef7"><B>Money</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">amount_minor: integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">currency: string</FONT></TD></TR></TABLE>>];
    "StepResult" [label=<<TABLE BGCOLOR="#ffffff" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8eef7"><B>StepResult</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">step_id: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">intent: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">locator_layer_hit?: scalar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">recoveries_applied?: list[scalar]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">duration_ms: integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">extracted?: Money</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_2 {
    label="Caller-facing result"; color="#b9c6d8"; penwidth=1; style="rounded";
    "ReplayResult" [label=<<TABLE BGCOLOR="#ffffff" BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e8eef7"><B>ReplayResult</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">capability_id: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">capability_version: integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">run_id: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">outputs?: Money</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">outcome?: BusinessOutcomeResult</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">failure?: FailureDetail</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">escalation?: EscalationRef</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">steps?: list[StepResult]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">started_at: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ended_at: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">evidence_dir: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">redactions?: list[scalar]</FONT></TD></TR></TABLE>>];
  }
  "BusinessOutcomeResult" -> "Money" [label="outputs"];
  "ReplayResult" -> "Money" [label="outputs"];
  "ReplayResult" -> "BusinessOutcomeResult" [label="outcome"];
  "ReplayResult" -> "FailureDetail" [label="failure"];
  "ReplayResult" -> "EscalationRef" [label="escalation"];
  "ReplayResult" -> "StepResult" [label="steps"];
  "StepResult" -> "Money" [label="extracted"];
}
